{
  "name": "@mirageprivacy/sdk",
  "version": "0.3.1",
  "description": "SDK for private transfers on Mirage",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "check": "tsc --noEmit",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:watch": "vitest --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration/",
    "test:testnet": "TESTNET=tempo vitest run test/integration/",
    "test:all": "vitest run"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@phala/dcap-qvl": "^0.6.1",
    "eciesjs": "^0.4.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "viem": "^2.0.0",
    "vitest": "^3.0.0"
  },
  "license": "UNLICENSED"
}
